<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Borne" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/primaire</item>
        <item name="android:colorPrimaryDark">@color/primaire_fonce</item>
        <item name="android:colorAccent">@color/primaire</item>
        <item name="android:windowBackground">@color/fond</item>
        <item name="android:statusBarColor">@color/primaire_fonce</item>
        <item name="android:textColor">@color/texte</item>
    </style>

    <style name="Carte">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/carte</item>
        <item name="android:padding">16dp</item>
        <item name="android:layout_marginBottom">12dp</item>
    </style>

    <style name="TitreCarte">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginBottom">6dp</item>
    </style>

    <style name="Aide">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/discret</item>
    </style>

    <style name="Bouton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:background">@drawable/bouton_secondaire</item>
        <item name="android:textColor">@color/texte</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="BoutonPrincipal" parent="Bouton">
        <item name="android:background">@drawable/bouton_principal</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
