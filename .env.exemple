# Copier en .env et adapter. Ne jamais committer le fichier .env réel.

# --- Production (serveur du centre) ---
DJANGO_DEBUG=False
# Clé aléatoire de 50 caractères minimum, par exemple :
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
# Nom et adresse IP du serveur sur le réseau local, séparés par des virgules.
DJANGO_ALLOWED_HOSTS=192.168.1.10,serveur-files.local,localhost,127.0.0.1
# Seulement si le site est servi en HTTPS (sinon laisser False).
DJANGO_HTTPS=False
DJANGO_CSRF_TRUSTED_ORIGINS=
# Durée de session des agents (secondes) ; la borne et l'écran restent activés.
SESSION_DUREE_SECONDES=43200

# Borne et écran limités aux adresses du réseau local.
RESEAU_LOCAL_UNIQUEMENT=True
BORNE_DELAI_MIN_SECONDES=2

# --- PostgreSQL ---
DB_NAME=gestion_file_attente
DB_USER=gestion_app
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
