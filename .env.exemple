# Copier en .env et adapter. Ne jamais committer le fichier .env réel.

# --- Production (serveur du centre) ---
DJANGO_DEBUG=False
# Clé aléatoire de 50 caractères minimum, par exemple :
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
# Nom et adresse IP du serveur sur le réseau local, séparés par des virgules.
DJANGO_ALLOWED_HOSTS=192.168.1.10,serveur-files.local,localhost,127.0.0.1
# True dès que Nginx sert le site en HTTPS (guide de déploiement, étape 6) ;
# False seulement en HTTP simple, sinon les cookies ne seraient pas envoyés.
DJANGO_HTTPS=True
DJANGO_CSRF_TRUSTED_ORIGINS=
# Derrière Nginx : adresse du proxy dont l'en-tête X-Real-IP est cru.
# OBLIGATOIRE en production : 127.0.0.1. Vide, tous les clients auraient
# l'adresse de Nginx (blocage des connexions commun à tous, journal faux).
# Vide seulement en développement (runserver, sans Nginx).
DJANGO_PROXIES_CONFIANCE=127.0.0.1
# Durée de session des agents (secondes) ; la borne et l'écran restent activés.
SESSION_DUREE_SECONDES=43200
# Cache commun aux processus Gunicorn, dans des fichiers (comptes connectés,
# verrous). Vide : dossier temporaire du service, vidé à chaque redémarrage.
DJANGO_CACHE_DOSSIER=

# Borne et écran limités aux adresses du réseau local.
RESEAU_LOCAL_UNIQUEMENT=True
BORNE_DELAI_MIN_SECONDES=2
# Plafond de tickets par borne sur une heure glissante.
BORNE_MAX_TICKETS_PAR_HEURE=150

# Connexion : blocage après 5 échecs (identifiant + poste) ou 20 échecs (poste).
CONNEXION_MAX_ECHECS=5
CONNEXION_MAX_ECHECS_IP=20

# --- PostgreSQL ---
DB_NAME=gestion_file_attente
DB_USER=gestion_app
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
